# ── Blockchain (Production — Sepolia testnet) ──────────────────────────────
# Get from: https://alchemy.com → Create App → Ethereum Sepolia → HTTP URL
BLOCKCHAIN_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/YOUR_ALCHEMY_KEY

# MetaMask wallet private key (the account that deployed the contract)
# Export from MetaMask: Account Details → Show Private Key
DEPLOYER_PRIVATE_KEY=0xYOUR_PRIVATE_KEY_HERE

# Contract address printed after running: npm run deploy:sepolia
CONTRACT_ADDRESS=0xYOUR_DEPLOYED_CONTRACT_ADDRESS

# Deployment timestamp (optional)
DEPLOYED_AT=2026-05-16T00:00:00.000Z

# ── App ────────────────────────────────────────────────────────────────────
# Random secret for JWT tokens — change this to any long random string
TOKEN_SECRET=change-this-to-a-long-random-secret-string

# Port (Railway sets this automatically)
PORT=3000
